# MongoDB connection string. Use "memory" for a throwaway in-memory database
# seeded with sample characters (no install needed), or an Atlas / local URI.
MONGODB_URI=memory
# Port the API listens on
PORT=5555
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGIN=http://localhost:5173
# Creates, edits and deletes allowed per visitor every 15 minutes
WRITE_RATE_LIMIT=60
# Number of proxies in front of the API (0 locally, 2 behind Vercel + Render)
TRUST_PROXY=0
